{
  "schemaVersion": 1,
  "id": "org.hebrewbooks2026.otzaria-search",
  "name": "היברובוקס",
  "version": "0.5.4",
  "description": "חיפוש וקריאת ספרי HebrewBooks ישירות מתוך אוצריא.",
  "author": "קהילת אוצריא",
  "stability": "experimental",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "network.localhost",
    "app.startup_contributions",
    "database.read",
    "library.books.read",
    "reader.open",
    "reader.toolbar",
    "search.fulltext.read",
    "search.dialog",
    "ui.feedback",
    "app.open_url",
    "events.subscribe:theme.changed",
    "settings.read",
    "events.subscribe:settings.changed"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "http://127.0.0.1:8080"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "היברובוקס",
      "order": 900,
      "allowOrderBeforeBuiltIns": false,
      "defaultPinned": true,
      "iconName": "book_search_24_regular"
    },
    "databaseSources": [
      {
        "id": "external_catalog",
        "label": "קטלוגים חיצוניים",
        "required": true
      }
    ],
    "startup": {
      "programs": [
        {
          "id": "find-parallel-editions",
          "version": 2,
          "triggers": [
            "reader.activeBookChanged"
          ],
          "when": {
            "op": "or",
            "conditions": [
              {
                "op": "exists",
                "value": {
                  "$context": "reader.book.id"
                }
              },
              {
                "op": "and",
                "conditions": [
                  {
                    "op": "equals",
                    "left": {
                      "$context": "reader.book.external.provider"
                    },
                    "right": {
                      "$literal": "hebrewbooks"
                    }
                  },
                  {
                    "op": "exists",
                    "value": {
                      "$context": "reader.book.external.id"
                    }
                  }
                ]
              }
            ]
          },
          "commands": [
            {
              "id": "editions",
              "type": "library.parallelEditions",
              "args": {
                "identity": {
                  "id": {
                    "$context": "reader.book.id"
                  },
                  "bookId": {
                    "$context": "reader.book.bookId"
                  },
                  "type": {
                    "$context": "reader.book.type"
                  },
                  "source": {
                    "$context": "reader.book.source"
                  },
                  "external": {
                    "provider": {
                      "$context": "reader.book.external.provider"
                    },
                    "id": {
                      "$context": "reader.book.external.id"
                    }
                  }
                }
              }
            },
            {
              "id": "defaultEdition",
              "type": "data.first",
              "args": {
                "items": {
                  "$result": "editions"
                }
              }
            }
          ],
          "outputs": {
            "editions": {
              "$result": "editions"
            },
            "defaultEdition": {
              "$result": "defaultEdition"
            }
          }
        }
      ],
      "toolbarItems": [
        {
          "id": "show-parallel-edition-beside",
          "type": "split",
          "title": "הצג מהדורה מקבילה לצד הספר",
          "icon": "dual_screen_24_regular",
          "placement": "overflow",
          "contexts": [
            "reader-text",
            "reader-pdf"
          ],
          "binding": {
            "program": "find-parallel-editions",
            "visibleOutput": "defaultEdition"
          },
          "action": {
            "type": "reader.openBookInSidePane",
            "args": {
              "identity": {
                "$output": "defaultEdition.identity"
              }
            }
          },
          "childrenBinding": {
            "itemsOutput": "editions",
            "maxItems": 20,
            "itemTemplate": {
              "id": {
                "$concat": [
                  "beside-edition-",
                  {
                    "$item": "identity.id"
                  },
                  "-",
                  {
                    "$item": "identity.external.id"
                  }
                ]
              },
              "title": {
                "$item": "title"
              },
              "action": {
                "type": "reader.openBookInSidePane",
                "args": {
                  "identity": {
                    "$item": "identity"
                  }
                }
              }
            }
          }
        }
      ],
      "searchDialogItems": [
        {
          "id": "include-hebrewbooks",
          "type": "checkbox",
          "title": "חפש גם בהיברובוקס",
          "defaultValue": false,
          "openPluginOnSubmit": true,
          "visibleInModes": [
            "exact",
            "advanced"
          ],
          "disabledSearchOptions": {
            "advanced": [
              "word.grammatical-suffixes",
              "word.prefixes",
              "word.suffixes",
              "word.partial",
              "word.typo-tolerance",
              "word.aramaic-prefixes",
              "word.aramaic-suffixes",
              "word.ignore-quotes",
              "word.nikud",
              "word.taamim"
            ]
          }
        }
      ]
    },
    "publishedDataTypes": []
  }
}
